{
  "name": "classic-basic",
  "version": "0.5.3",
  "private": true,
  "scripts": {
    "build": "cross-env NODE_ENV=production rollup -c node:@mirta/rollup/config",
    "build:mono": "rollup -c node:@mirta/rollup/config",
    "wb:deploy": "mirta deploy --dry-run"
  },
  "type": "module",
  "imports": {
    "#wb/*": [
      "./src/wb-rules/*.js"
    ],
    "#wbm/*": [
      "./src/wb-rules-modules/*.js"
    ]
  },
  "dependencies": {
    "mirta": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@mirta/globals": "workspace:*",
    "@mirta/rollup": "workspace:*",
    "@mirta/tsconfig": "workspace:*",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.12.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "globals": "^17.6.0",
    "rollup": "^4.60.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
