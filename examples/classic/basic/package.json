{
  "name": "classic-basic",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "cross-env NODE_ENV=production rollup -c",
    "build:mono": "cross-env NODE_ENV=production rollup -c node:@mirta/rollup/config"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "type": "module",
  "imports": {
    "#wb/*": [
      "./src/wb-rules/*.js"
    ],
    "#wbm/*": [
      "./src/wb-rules-modules/*.js"
    ]
  },
  "dependencies": {
    "mirta": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@mirta/globals": "workspace:*",
    "@mirta/rollup": "workspace:*",
    "@mirta/tsconfig": "workspace:*",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@types/node": "^24.9.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "rollup": "^4.52.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.2"
  }
}
