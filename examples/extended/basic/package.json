{
  "name": "extended-basic",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "cross-env NODE_ENV=production rollup -c node:@mirta/rollup/config",
    "build:mono": "rollup -c node:@mirta/rollup/config",
    "wb:deploy": "mirta deploy --dry-run"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "type": "module",
  "imports": {
    "#wb/*": [
      "./src/wb-rules/*.js"
    ],
    "#wbm/*": [
      "./src/wb-rules-modules/*.js"
    ]
  },
  "dependencies": {
    "mirta": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@mirta/globals": "workspace:*",
    "@mirta/rollup": "workspace:*",
    "@mirta/tsconfig": "workspace:*",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^24.10.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "globals": "^17.0.0",
    "rollup": "^4.55.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.49.0"
  }
}
