{
  "name": "@mirta/cli",
  "description": "🛠️ Mirta Framework - the CLI",
  "version": "0.4.5",
  "license": "Unlicense",
  "keywords": [
    "cli",
    "mirta",
    "wb-rules"
  ],
  "type": "module",
  "files": [
    "bin",
    "dist",
    "locales",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "mirta": "bin/mirta.mjs"
  },
  "imports": {
    "#src/*": "./src/*.js",
    "#src/i18n": "./src/i18n/index.js",
    "#src/auth": "./src/auth/index.js",
    "#src/staged-args": "./src/staged-args/index.js",
    "#src/staged-args/*": "./src/staged-args/*.js",
    "#src/config/connection": "./src/config/connection/index.js",
    "#*": [
      "./src/*.js",
      "./src/*/index.js"
    ]
  },
  "homepage": "https://github.com/wb-mirta/core/tree/latest/packages/mirta-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wb-mirta/core.git",
    "directory": "packages/mirta-cli"
  },
  "bugs": {
    "url": "https://github.com/wb-mirta/core/issues"
  },
  "scripts": {
    "build:mono": "rollup -c node:@mirta/rollup/config-package --config-skip-exports",
    "i18n:shape-gen": "node ../../scripts/i18n/shape-gen.mjs"
  },
  "funding": {
    "type": "individual",
    "url": "https://boosty.to/wihome/donate"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@mirta/basics": "workspace:*",
    "@mirta/env-loader": "workspace:*",
    "@mirta/i18n": "workspace:*",
    "@mirta/package": "workspace:*",
    "@mirta/staged-args": "workspace:*",
    "@mirta/workspace": "workspace:*",
    "p-map": "^7.0.4",
    "chalk": "^5.6.2",
    "prompts": "^2.4.2",
    "semver": "^7.7.3",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
