{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // @0.4.6: Множественные корни в пакетах пока не поддерживаются (ошибка генерации dts)
    // "rootDirs": ["src", "../../"],
    "rootDir": "src",
    // При сборке предотвращает использование перенаправлений
    // на исходники в других проектах
    "paths": {}
  },
  "include": [
    // Обработка исходных кодов проекта: файлы JS и TS
    "src/**/*.js",
    "src/**/*.ts",
    // @0.4.6: Глобальные типы в пакетах пока не поддерживаются
    //"../../types/*.d.ts"
  ]
}
