{
  "name": "{{packageFull}}",
  "version": "0.0.0",
  "keywords": [
    "mirta",
    "wb-rules"
  ],
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "imports": {
    "#src/*": "./src/*.js"
  }
}
