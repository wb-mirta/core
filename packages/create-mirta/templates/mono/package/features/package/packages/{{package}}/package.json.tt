{
  "name": "{{packageFull}}",
  "version": "0.0.0",
  "keywords": [
    "mirta",
    "wb-rules"
  ],
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "imports": {
    "#*": ["./src/*.js", "./src/*/index.js"]
  },
  "scripts": {
    "build:mono": "rollup -c node:@mirta/rollup/config-package"
  }
}
