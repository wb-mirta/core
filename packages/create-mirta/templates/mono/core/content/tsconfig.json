{
  "extends": "@mirta/tsconfig",
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "types": [
      "@mirta/globals",
      "node"
    ]
  },
  "include": [
    "*.ts",
    "*.mts",
    "types/*.d.ts",

    // === JS ===

    "packages/*/src/**/*.js",
    "packages/*/tests/**/*.js",

    "projects/*/src/**/*.js",
    "projects/*/tests/**/*.js",

    // === TS ===

    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",

    "projects/*/src/**/*.ts",
    "projects/*/tests/**/*.ts"
  ]
}
