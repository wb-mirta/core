{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // Добавляет поддержку корня монорепозитория (для типизации)
    "rootDirs": [".", "../../"],
    // При сборке предотвращает использование перенаправлений
    // на исходники в других проектах
    "paths": {}
  },
  "include": [
    // Обработка исходных кодов проекта: файлы JS и TS
    "src/**/*.js",
    "src/**/*.ts",
    // Глобальные типы (для определений .env)
    "../../types/*.d.ts"
  ]
}
