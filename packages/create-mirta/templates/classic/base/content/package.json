    "@mirta/rollup": "0.3.5",
    "@mirta/tsconfig": "0.3.5",
    "@types/node": "^24.10.1",
    "cross-env": "^10.1.0",
    "rollup": "^4.53.2",
    "typescript": "^5.8.3"
  }
