{
  "name": "create-mirta",
  "description": "🛠️ The recommended way to start a Mirta project",
  "version": "0.4.2",
  "license": "Unlicense",
  "keywords": [
    "mirta",
    "wb-rules"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*.js",
    "#i18n": "./src/i18n/index.js",
    "#jsonc": "./src/jsonc/index.js",
    "#errors": "./src/errors/index.js",
    "#runners": "./src/runners/index.js",
    "#locales/*": "./locales/*.json"
  },
  "files": [
    "dist",
    "assets",
    "locales",
    "templates",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "create-mirta": "dist/index.mjs"
  },
  "homepage": "https://github.com/wb-mirta/core/tree/latest/packages/create-mirta#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wb-mirta/core.git",
    "directory": "packages/create-mirta"
  },
  "bugs": {
    "url": "https://github.com/wb-mirta/core/issues"
  },
  "scripts": {
    "build:mono": "rollup -c node:@mirta/rollup/config-package --config-skip-exports",
    "i18n:shape-gen": "node ../../scripts/i18n/shape-gen.mjs",
    "create": "node dist/index.mjs"
  },
  "dependencies": {
    "@mirta/basics": "workspace:*",
    "@mirta/i18n": "workspace:*",
    "@mirta/staged-args": "workspace:*",
    "prompts": "^2.4.2",
    "chalk": "^5.6.2",
    "gradient-string": "^3.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
