{
  "private": true,
  "engines": {
    "node": ">=20.6.0"
  },
  "type": "module",
  "imports": {
    "#wb/*": [
      "./src/wb-rules/*.js"
    ],
    "#wbm/*": [
      "./src/wb-rules-modules/*.js"
    ]
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production rollup -c node:@mirta/rollup/config",
    "build:dev": "cross-env NODE_ENV=development rollup -c node:@mirta/rollup/config"
  },
  "dependencies": {
    "mirta": "0.3.5"
  },
  "devDependencies": {
    "@mirta/rollup": "0.3.5",
    "cross-env": "^10.1.0",
    "rollup": "^4.52.5"
  }
}
