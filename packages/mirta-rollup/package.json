{
  "name": "@mirta/rollup",
  "description": "Predefined Rollup configuration for wb-rules project builds.",
  "version": "0.3.5",
  "sideEffects": false,
  "license": "Unlicense",
  "keywords": [
    "mirta",
    "wb-rules"
  ],
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "default": "./dist/config.mjs"
    },
    "./config-package": {
      "types": "./dist/config-package.d.mts",
      "default": "./dist/config-package.mjs"
    },
    "./env-loader": {
      "types": "./dist/utils/env-loader.d.mts",
      "default": "./dist/utils/env-loader.mjs"
    }
  },
  "imports": {
    "#src/*": "./src/*.js",
    "#ast": "./src/ast-transformers/index.js",
    "#utils/*": "./src/utils/*.js",
    "#utils/monorepo": "./src/utils/monorepo/index.js",
    "#plugins/*": "./src/plugins/*.js",
    "#configs/*": "./src/configs/*.js"
  },
  "homepage": "https://github.com/wb-mirta/core/tree/latest/packages/mirta-rollup#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wb-mirta/core.git",
    "directory": "packages/mirta-rollup"
  },
  "bugs": {
    "url": "https://github.com/wb-mirta/core/issues"
  },
  "scripts": {
    "build:mono": "rollup -c --configPlugin typescript={tsconfig:\\\"./tsconfig.build.json\\\"}"
  },
  "dependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@dotenvx/dotenvx": "^1.51.0",
    "@mirta/basics": "workspace:*",
    "@mirta/package": "workspace:*",
    "@mirta/workspace": "workspace:*",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-multi-entry": "^6.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "babel-plugin-array-includes": "^2.0.3",
    "del": "^8.0.1",
    "magic-string": "^0.30.21",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-typescript2": "^0.36.0",
    "find-up": "^8.0.0"
  },
  "devDependencies": {
    "rollup": "^4.52.5",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "rollup": ">= 4.52.5 < 5",
    "typescript": ">= 5.8.3 < 6"
  }
}
