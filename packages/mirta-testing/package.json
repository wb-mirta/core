{
  "name": "@mirta/testing",
  "description": "A unit-test runner equipped with built-in Wiren Board runtime emulation",
  "version": "0.4.1",
  "license": "Unlicense",
  "keywords": [
    "mirta",
    "wb-rules"
  ],
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./config": {
      "import": "./dist/config/index.mjs"
    },
    "./setup-global": {
      "import": "./dist/setup/global.mjs"
    }
  },
  "homepage": "https://github.com/wb-mirta/core/tree/latest/packages/mirta-testing#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wb-mirta/core.git",
    "directory": "packages/mirta-testing"
  },
  "bugs": {
    "url": "https://github.com/wb-mirta/core/issues"
  },
  "scripts": {
    "build:mono": "rollup -c"
  },
  "dependencies": {
    "@mirta/env-loader": "workspace:*",
    "@mirta/workspace": "workspace:*",
    "mirta": "workspace:*",
    "vitest-mock-extended": "^3.1.0"
  },
  "devDependencies": {
    "@mirta/rollup": "workspace:*"
  }
}
