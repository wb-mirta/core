{
  "private": true,
  "version": "0.3.5",
  "license": "Unlicense",
  "engines": {
    "node": ">=22.17.1"
  },
  "packageManager": "pnpm@10.19.0",
  "workspaces": [
    "packages/*",
    "examples/*/*"
  ],
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prebuild:cli": "pnpm prebuild",
    "build:cli": "cross-env NODE_ENV=production pnpm --filter @mirta/cli run build:mono",
    "prebuild": "cross-env NODE_ENV=production pnpm --filter @mirta/rollup run build:mono",
    "build": "cross-env NODE_ENV=production pnpm --filter ./packages/* --filter !@mirta/rollup --filter ./examples/*/* run build:mono",
    "release": "mirta release",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "simple-git-hooks",
    "pack:dev": "pnpm pack --recursive --filter ./packages/* --pack-destination /packed"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "node scripts/verify-commit.js"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@eslint/json": "^0.13.2",
    "@mirta/cli": "workspace:*",
    "@mirta/globals": "workspace:*",
    "@mirta/rollup": "workspace:*",
    "@mirta/tsconfig": "workspace:*",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@types/node": "^24.9.1",
    "@types/prompts": "^2.4.9",
    "chalk": "^5.6.2",
    "conventional-changelog-cli": "^5.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.38.0",
    "@vitest/eslint-plugin": "^1.3.23",
    "eslint-plugin-workspaces": "^0.11.0",
    "globals": "^16.4.0",
    "lint-staged": "^16.2.6",
    "rollup": "^4.52.5",
    "simple-git-hooks": "^2.13.1",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4",
    "vitest-mock-extended": "^3.1.0"
  }
}
