{
  "private": true,
  "version": "0.5.3",
  "license": "Unlicense",
  "workspaces": [
    "packages/*",
    "examples/*/*"
  ],
  "type": "module",
  "scripts": {
    "bootstrap": "cross-env NODE_ENV=production rollup -c --configPlugin typescript={tsconfig:\\\"./tsconfig.bootstrap.json\\\"}",
    "prepare": "pnpm bootstrap",
    "test": "vitest run --config @mirta/testing/config",
    "coverage": "vitest run --coverage",
    "build:cli": "cross-env NODE_ENV=production pnpm --filter @mirta/cli run build:mono",
    "prebuild": "pnpm bootstrap",
    "build": "cross-env NODE_ENV=production node ./scripts/build.mjs",
    "release": "mirta release",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "simple-git-hooks",
    "pack:dev": "pnpm pack --recursive --filter ./packages/* --pack-destination /packed",
    "i18n:shape-gen": "pnpm --filter ./packages/* run i18n:shape-gen"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "node scripts/verify-commit.js"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored"
    ]
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.66.0",
    "@eslint/js": "^9.39.4",
    "@eslint/json": "^1.2.0",
    "@mirta/cli": "workspace:*",
    "@mirta/globals": "workspace:*",
    "@mirta/package": "workspace:*",
    "@mirta/rollup": "workspace:*",
    "@mirta/testing": "workspace:*",
    "@mirta/tsconfig": "workspace:*",
    "@rollup/plugin-typescript": "^12.3.0",
    "@rollup/plugin-multi-entry": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-babel": "^7.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.12.4",
    "@types/prompts": "^2.4.9",
    "chalk": "^5.6.2",
    "conventional-changelog-cli": "^5.0.0",
    "cross-env": "^10.1.0",
    "del": "^8.0.1",
    "eslint": "^9.39.4",
    "@vitest/eslint-plugin": "^1.6.17",
    "eslint-plugin-workspaces": "^0.12.1",
    "find-up": "^8.0.0",
    "globals": "^17.6.0",
    "magic-string": "^0.30.21",
    "lint-staged": "^16.4.0",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.4.1",
    "simple-git-hooks": "^2.13.1",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6",
    "vitest-mock-extended": "^4.0.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "packageManager": "pnpm@10.33.4"
}
